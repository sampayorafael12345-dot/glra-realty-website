# =============================================================
# GLRA Realty — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit .env to git.
# =============================================================

# --- MongoDB ---
# Get a fresh connection string from MongoDB Atlas after rotating the password
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/glra_realty?retryWrites=true&w=majority

# --- JWT (used to sign admin login tokens) ---
# Generate a strong random secret, e.g. with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=8h
# Optional. Signs the unsubscribe / confirm links inside emails. Falls back to
# JWT_SECRET. Before you ever rotate JWT_SECRET, set LINK_SECRET to the OLD
# JWT_SECRET value first, or every unsubscribe link already sent stops working.
# LINK_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Brevo (transactional email) ---
BREVO_API_KEY=your_brevo_api_key

# --- AI chatbot (server/chatbot.js uses Google Gemini, with Groq as a fallback) ---
# GEMINI_MODEL is optional: if it is unset or Google retires the name, the
# server reads Google's live model list and picks the newest Flash model.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=optional_groq_api_key

# --- Default admin account (only used to seed the FIRST admin) ---
# After first login, change this in the admin panel and remove from .env.
ADMIN_EMAIL=admin@glrarealty.com
ADMIN_PASSWORD=change-me-on-first-login

# --- CORS allowed origins (comma-separated, no trailing slash) ---
# Production example: https://glrarealty.com,https://www.glrarealty.com
ALLOWED_ORIGINS=http://localhost:3000

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Meta: Facebook / Instagram (server/meta.js) ---
# Each part has its own switch and is OFF unless set to 1. While a switch is
# off its routes answer 404 and nothing calls Meta. See README, "Facebook and
# Instagram (Meta)". Real values go in Render only, never in this file.
META_LEADS_ENABLED=0
META_INSIGHTS_ENABLED=0
META_INBOX_ENABLED=0
# App settings > Basic (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
# Any long random string; type the same one into the app's Webhooks page.
META_VERIFY_TOKEN=
# Business Settings > System users > Generate token (expiry: Never)
META_SYSTEM_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# With or without the act_ prefix
META_AD_ACCOUNT_ID=
# Optional; the code is written against this version
META_GRAPH_VERSION=v24.0

# --- GLRA Social: the Facebook / Instagram Page manager (server/social.js) ---
# OFF unless 1: while off, every /api/admin/social, /api/social route answers
# 404 and nothing runs. Uses META_APP_ID / META_APP_SECRET / META_SYSTEM_TOKEN
# above (the system user must have every Page assigned with Full control).
SOCIAL_ENABLED=0
# The Page ids, comma separated (GLRA Realty, GLRA Land Title, Kate Sampayo).
# Falls back to META_PAGE_ID. Each Page's Instagram account is found by itself.
META_PAGE_IDS=
# "Write with AI" / "Suggest a reply" reuse the website chat's GEMINI_API_KEY /
# GROQ_API_KEY (and PRIMARY_LLM). Nothing extra to set.

# --- Telegram alert for new Facebook / Instagram leads (optional) ---
# @BotFather > /newbot gives the token; the chat id is shown in the admin Meta
# tab ("Find my Telegram chat id") after you send the bot a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
